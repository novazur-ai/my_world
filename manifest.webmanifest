{
  "name": "My World",
  "short_name": "My World",
  "description": "Mon tableau de bord de vie",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0F1012",
  "theme_color": "#F2F6F9",
  "icons": [
    {
      "src": "icons/icon-192-v6.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "Mes cartes de fidélité",
      "short_name": "Mes cartes",
      "description": "Afficher tes cartes de fidélité",
      "url": "./#cartes",
      "icons": [
        {
          "src": "icons/sc-cartes-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/sc-cartes-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
