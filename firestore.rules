rules_version = '2';
// Seul le propriétaire, connectée avec son compte Google, peut lire et écrire ses propres données.
// La GitHub Action de la Gazette passe par un compte de service : elle n'est pas concernée par ces règles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "t.mallet06@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
